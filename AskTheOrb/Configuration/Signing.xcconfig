// Signing configuration for Ask the Orb.
//
// Set DEVELOPMENT_TEAM to your 10-character Apple Developer Team ID, found at
// developer.apple.com/account → Membership. Leaving it empty is fine for
// simulator builds; Xcode will prompt you to pick a team the first time you
// build for a device.
//
// fastlane overrides this on CI via the `xcargs` it passes to xcodebuild, so
// committing an empty value here is safe.

DEVELOPMENT_TEAM =

// Automatic signing lets Xcode create and refresh the profiles for you, which
// is the right default for a solo developer. Switch to Manual + fastlane match
// only if several people or machines need to sign the same app.
CODE_SIGN_STYLE = Automatic
